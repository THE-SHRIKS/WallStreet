---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../data/site";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/layouts.css";
import "../styles/visuals.css";
import "../styles/pages.css";
import "../styles/home.css";
import "../styles/product.css";
import "../styles/engineering.css";
import "../styles/editorial.css";
import "../styles/interactions.css";

interface Props {
  title: string;
  description?: string;
  active?: string;
  theme?: "ink" | "paper";
  type?: "website" | "article";
}

const {
  title,
  description = SITE_DESCRIPTION,
  active = "",
  theme = "ink",
  type = "website",
} = Astro.props;
const pageTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL("/assets/pixel/system-desktop.png", Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101719" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content="Illustrative pixel-art system path; not live market data." />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader active={active} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script src="../scripts/site-controls.ts"></script>
  </body>
</html>
