---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../data/site";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "@fontsource/newsreader/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/tiny5";
import "../styles/tokens.css";

import "../styles/global.css";
import "../styles/layouts.css";
import "../styles/visuals.css";
import "../styles/pages.css";
import "../styles/home.css";
import "../styles/product.css";
import "../styles/engineering.css";
import "../styles/editorial.css";
import "../styles/interactions.css";
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  active?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  active = "",
  type = "website",
  noindex = false,
} = Astro.props;
const pageTitle =
  title === SITE_NAME ? `${SITE_NAME}: agent-driven finance, built in the open` : `${title} — ${SITE_NAME}`;
const origin = (Astro.site ?? new URL("https://wallstreet.theshriks.space")).origin;
const path = Astro.url.pathname.replace(/\/index\.html$/, "/");
const canonicalUrl = new URL(path, origin).href;
const socialImage = new URL("/og-image.png", origin).href;
const isHome = path === "/";
const segments = path.split("/").filter(Boolean);
const crumbName = (seg: string, last: boolean) =>
  last ? title : seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, " ");
const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: `${origin}/` },
    ...segments.map((seg, i) => ({
      "@type": "ListItem",
      position: i + 2,
      name: crumbName(seg, i === segments.length - 1),
      item: new URL("/" + segments.slice(0, i + 1).join("/"), origin).href,
    })),
  ],
};
const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": `${origin}/#organization`,
    name: "THE SHRIKS",
    url: "https://github.com/THE-SHRIKS",
    sameAs: ["https://github.com/THE-SHRIKS"],
  },
  {
    "@type": "WebSite",
    "@id": `${origin}/#website`,
    url: `${origin}/`,
    name: SITE_NAME,
    description: SITE_DESCRIPTION,
    inLanguage: "en",
    publisher: { "@id": `${origin}/#organization` },
  },
  {
    "@type": type === "article" ? "TechArticle" : "WebPage",
    "@id": `${canonicalUrl}#page`,
    url: canonicalUrl,
    name: pageTitle,
    headline: title,
    description,
    inLanguage: "en",
    isPartOf: { "@id": `${origin}/#website` },
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    image: socialImage,
  },
];
if (isHome) {
  graph.push({
    "@type": "SoftwareSourceCode",
    "@id": `${origin}/#source`,
    name: SITE_NAME,
    codeRepository: "https://github.com/THE-SHRIKS/WallStreet",
    programmingLanguage: ["TypeScript", "JavaScript", "Python", "Solidity"],
    description: SITE_DESCRIPTION,
    author: { "@id": `${origin}/#organization` },
  });
} else {
  graph.push(breadcrumb);
}
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="author" content="THE SHRIKS" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wall Street: agent-driven finance, built in the open." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={jsonLd} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader active={active} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script src="../scripts/site-controls.ts"></script>
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/seams.ts"></script>
  </body>
</html>
