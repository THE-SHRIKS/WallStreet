---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CodeEnhancer from "../components/CodeEnhancer.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import { getCollection } from "astro:content";

interface TocItem {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  activeSlug?: string;
  toc?: TocItem[];
}

const { title, description, activeSlug, toc = [] } = Astro.props;
const docEntries = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const items = docEntries.map((entry) => ({ slug: entry.id, navLabel: entry.data.navLabel }));
---

<BaseLayout title={title} description={description} active="docs">
  <div class="docs-shell wrap">
    <aside class="docs-shell__sidebar" aria-label="Documentation navigation">
      <DocsSidebar items={items} activeSlug={activeSlug} />
    </aside>

    <div class="docs-shell__main">
      <Breadcrumbs items={[{ label: "Docs", href: "/docs" }, ...(activeSlug ? [{ label: title }] : [])]} />
      <div class="docs-layout">
        <article class="prose docs-article">
          <header class="docs-article__header">
            <p class="eyebrow">Wall Street · Documentation</p>
            <h1>{title}</h1>
            <p class="docs-article__description">{description}</p>
          </header>
          <div class="prose__body">
            <slot />
          </div>
          <footer class="docs-article__footer">
            <p>These notes describe the reviewed source, not a promise of production behavior.</p>
            <a class="text-link" href="/engineering">Open the interactive architecture map</a>
          </footer>
        </article>

        {toc.length > 0 && (
          <aside class="toc-rail" aria-label="On this page">
            <p class="toc-rail__title">On this page</p>
            <nav aria-label="Page sections">
              <ol>
                {toc.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
              </ol>
            </nav>
          </aside>
        )}
      </div>
    </div>
  </div>
  <CodeEnhancer />
</BaseLayout>
