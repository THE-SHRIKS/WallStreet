---
interface Props {
  current?: boolean;
}

const { current = false } = Astro.props;
---

<a class="brand" href="/" aria-label="Wall Street home" aria-current={current ? "page" : undefined}>
  <svg class="brand__symbol" viewBox="0 0 32 32" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
    <rect x="3" y="3" width="8" height="8" fill="#A6C6B8" />
    <rect x="13" y="3" width="6" height="8" fill="#E9EAE3" />
    <rect x="21" y="3" width="8" height="8" fill="#D9B16F" />
    <rect x="3" y="13" width="6" height="6" fill="#E9EAE3" />
    <rect x="11" y="13" width="10" height="6" fill="#D9B16F" />
    <rect x="23" y="13" width="6" height="6" fill="#A6C6B8" />
    <rect x="5" y="21" width="8" height="8" fill="#D78270" />
    <rect x="15" y="21" width="14" height="8" fill="#E9EAE3" />
  </svg>
  <span class="brand__name">Wall Street</span>
  <span class="brand__edition">Engineering notes</span>
</a>
