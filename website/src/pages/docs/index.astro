---
import DitherArt from "../../components/DitherArt.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getCollection } from "astro:content";
import { RESOURCES } from "../../data/resources";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
---

<DocsLayout title="Documentation" description="Source-grounded setup, architecture, agent, contract, and security notes for the WallStreet repository.">
  <div class="docs-index">
    <DitherArt class="intro-art" variant="horizon" label="Decorative dithered sunset over ridges." cell={4} />
    <p class="article-deck">A compact guide to the repository as it exists—not a promise that every package is wired into one running system.</p>
    <ol class="docs-index__list">
      {docs.map((entry, index) => (
        <li>
          <a href={`/docs/${entry.id}`}>
            <span class="docs-index__number">0{index + 1}</span>
            <span class="docs-index__copy"><strong>{entry.data.navLabel}</strong><span>{entry.data.description}</span></span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
    <h2 id="resources" class="docs-index__heading">Resources</h2>
    <p class="article-deck">Where to read, report, and reuse. Each entry says what it is and what it is not.</p>
    <ul class="resource-list">
      {RESOURCES.map((item) => (
        <li class="resource-list__item">
          <p class="resource-list__kind">{item.kind}</p>
          <h3><a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined}>{item.title}</a></h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ul>
    <div class="docs-index__note">
      <p><strong>Scope note.</strong> Website preview and build commands stay in <code>website/</code>. The existing React, API, Python, task-gateway, and contract packages have separate manifests. No root-level command is presented as a verified all-in-one launch.</p>
      <a class="text-link" href="/engineering">Open the source map</a>
    </div>
  </div>
</DocsLayout>
