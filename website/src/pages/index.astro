---
import BaseLayout from "../layouts/BaseLayout.astro";
import AgentGlyph from "../components/AgentGlyph.astro";
import ProcessStrip from "../components/ProcessStrip.astro";
import SourceLink from "../components/SourceLink.astro";
import StatusLabel from "../components/StatusLabel.astro";
import SystemSequence from "../components/SystemSequence.astro";
import { AUDIT_COMMIT, AUDIT_DATE, PROJECT_FACTS, REPOSITORY_URL } from "../data/project-facts";
import { SITE_DESCRIPTION } from "../data/site";

const agents = [
  { id: "yield-optimizer", name: "Yield optimizer", symbol: "yield" as const, status: "Prototype", summary: "Compares strategy candidates in source; it does not publish a current offer or realized return." },
  { id: "arbitrage-bot", name: "Arbitrage bot", symbol: "arbitrage" as const, status: "Simulated", summary: "A model path explores route differences. Execution is not verified as live or profitable." },
  { id: "risk-manager", name: "Risk manager", symbol: "barrier" as const, status: "Prototype", summary: "Contract thresholds are visible in source; they are not a promise that risk is contained." },
  { id: "portfolio-rebalancer", name: "Portfolio rebalancer", symbol: "rebalance" as const, status: "Simulated", summary: "The Python workflow demonstrates a rebalance proposal and explicitly simulates execution." },
 ] as const;

const processSteps = [
  { label: "Signal", href: "/engineering#data-flows" },
  { label: "Evaluate", href: "/product#yield-optimizer" },
  { label: "Risk", href: "/product#risk-manager" },
  { label: "Contract boundary", href: "/engineering#contracts" },
  { label: "Record", href: "/engineering#architecture" },
];

const evidence = PROJECT_FACTS.filter((fact) => fact.label !== "Database and persistence").slice(0, 4);
---

<BaseLayout title="Wall Street" description={SITE_DESCRIPTION} active="home">
  <section class="home-hero wrap" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="eyebrow">Wall Street <span aria-hidden="true">/</span> Source notes</p>
      <p class="home-hero__state"><span class="status-dot" aria-hidden="true"></span> In development · public codebase</p>
      <h1 id="home-title">Inside a <span>programmable</span> financial system.</h1>
      <p class="home-hero__intro">Explore the mechanics of a project in progress: specialist agents, risk markers, contract prototypes, and a simulated rebalance path. The site separates what the code contains from what it has not yet proved.</p>
      <div class="button-row">
        <a class="button button--light" href={REPOSITORY_URL} target="_blank" rel="noreferrer">Read the source <span aria-hidden="true">↗</span></a>
        <a class="button button--outline" href="/engineering">Understand the system</a>
      </div>
      <p class="home-hero__audit">Source reviewed {AUDIT_DATE} · <code>{AUDIT_COMMIT.slice(0, 7)}</code></p>
    </div>
    <SystemSequence />
  </section>

  <section class="home-process section section--paper" aria-labelledby="home-process-title">
    <div class="wrap">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">The path, as drawn</p>
          <h2 id="home-process-title">A sequence, not a promise.</h2>
        </div>
        <p>Each step names a code boundary. The animated route below is an illustration, not a feed, wallet action, or transaction receipt.</p>
      </div>
      <ProcessStrip steps={processSteps} label="Illustrative system sequence" />
      <div class="home-process__note">
        <AgentGlyph symbol="signal" size={28} />
        <p>The scene has a still state, one authored replay, and a reduced-motion fallback. Its labels remain readable without animation.</p>
        <a class="text-link" href="/engineering#architecture">Open the source map</a>
      </div>
    </div>
  </section>

  <section class="home-evidence section wrap" aria-labelledby="home-evidence-title">
    <div class="section-heading">
      <p class="eyebrow">What exists in the reviewed source</p>
      <h2 id="home-evidence-title">Built in pieces. Verified in context.</h2>
      <p>These are source-level observations pinned to one commit, not a claim that every package is connected or deployed.</p>
    </div>
    <div class="evidence-ledger">
      {evidence.map((fact, index) => (
        <article class="evidence-ledger__row">
          <span class="evidence-ledger__index">0{index + 1}</span>
          <div class="evidence-ledger__copy">
            <div class="evidence-ledger__heading"><h3>{fact.label}</h3><StatusLabel status={fact.status} compact /></div>
            <p>{fact.statement}</p>
          </div>
          <div class="evidence-ledger__sources">
            {fact.sourcePaths.slice(0, 2).map((path) => <SourceLink path={path} />)}
          </div>
        </article>
      ))}
    </div>
    <p class="section-footnote">A source file can exist without being a running service. <a href="/engineering">See the full component map and its limits.</a></p>
  </section>

  <section class="home-stack section section--paper" aria-labelledby="home-stack-title">
    <div class="wrap">
      <div class="section-heading section-heading--split">
        <div><p class="eyebrow">A codebase with separate edges</p><h2 id="home-stack-title">One repository. Several runtimes.</h2></div>
        <p>The source spans browser UI, services, Python workflows, contracts, and separate identity research. Shared folders do not prove a deployed pipeline.</p>
      </div>
      <div class="home-stack__body">
        <ol class="home-stack__list">
          <li>
            <span class="home-stack__index">01</span>
            <div class="home-stack__copy"><h3>Browser application</h3><p>React, TypeScript, and Vite views; some states are seeded or simulated.</p></div>
            <div class="home-stack__sources"><SourceLink path="LokiAi/src" kind="tree" label="React/Vite source" /></div>
          </li>
          <li>
            <span class="home-stack__index">02</span>
            <div class="home-stack__copy"><h3>API and data modules</h3><p>Node/Express, MongoDB-oriented files, and Socket.IO setup; external connections were not verified.</p></div>
            <div class="home-stack__sources"><SourceLink path="LokiAi/backend/server.js" /><SourceLink path="LokiAi/src/services/database/mongodb-service.ts" /></div>
          </li>
          <li>
            <span class="home-stack__index">03</span>
            <div class="home-stack__copy"><h3>Python workflows</h3><p>Allocation analysis and a separate FastAPI/Celery gateway; the rebalance trade path is simulated.</p></div>
            <div class="home-stack__sources"><SourceLink path="portfolio_rebalancer/rebalance_engine.py" /><SourceLink path="task_gateway/app.py" /></div>
          </li>
          <li>
            <span class="home-stack__index">04</span>
            <div class="home-stack__copy"><h3>Contract prototypes</h3><p>Four Solidity sources and local Hardhat tooling; mock paths are not a deployment record.</p></div>
            <div class="home-stack__sources"><SourceLink path="loki-contracts/contracts" kind="tree" label="Contract sources" /></div>
          </li>
          <li>
            <span class="home-stack__index">05</span>
            <div class="home-stack__copy"><h3>Separate identity research</h3><p>Keystroke and voice-authentication experiments are not presented as production identity enforcement.</p></div>
            <div class="home-stack__sources"><SourceLink path="ghost-key-main/ghost-key-main/README.md" /></div>
          </li>
        </ol>
        <aside class="home-stack__aside">
          <div class="home-stack__mark"><AgentGlyph symbol="relay" size={64} /></div>
          <p class="eyebrow">Read the boundary</p>
          <p>Start with the component map, then inspect each package’s own entrypoint and setup notes.</p>
          <a class="button button--outline-dark" href="/engineering#architecture">Explore the engineering map</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="home-agents section section--ink" aria-labelledby="home-agents-title">
    <div class="wrap">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Four specialist roles</p>
          <h2 id="home-agents-title">Different jobs. Different proof.</h2>
        </div>
        <p>Choose a role to inspect its source boundary. The overview does not connect a wallet, query a market, or make a recommendation.</p>
      </div>
      <div class="home-agent-list">
        {agents.map((agent, index) => (
          <a class={`home-agent home-agent--${agent.id}`} href={`/product#${agent.id}`}>
            <span class="home-agent__index">0{index + 1}</span>
            <span class="home-agent__glyph"><AgentGlyph symbol={agent.symbol} size={60} /></span>
            <span class="home-agent__content">
              <span class="home-agent__topline"><span class="home-agent__name">{agent.name}</span><StatusLabel status={agent.status} compact /></span>
              <span class="home-agent__summary">{agent.summary}</span>
            </span>
            <span class="home-agent__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="home-agents__footer">
        <p>No token prices, APYs, portfolio totals, or performance claims are shown.</p>
        <a class="button button--outline" href="/product">Explore the product notes</a>
      </div>
    </div>
  </section>

  <section class="home-reading section wrap" aria-labelledby="home-reading-title">
    <div class="section-heading">
      <p class="eyebrow">Read it like an engineer</p>
      <h2 id="home-reading-title">Start with the evidence.</h2>
    </div>
    <div class="home-reading__grid">
      <a class="reading-link" href="/engineering">
        <span class="reading-link__kind">System map</span>
        <h3>Which pieces are related—and which are not?</h3>
        <p>Explore the interactive diagram, text outline, contract set, and commit-pinned code map.</p>
        <span class="reading-link__arrow" aria-hidden="true">→</span>
      </a>
      <a class="reading-link" href="/articles">
        <span class="reading-link__kind">Engineering notes</span>
        <h3>Why simulation labels matter.</h3>
        <p>Three undated articles trace the gap between a model, a prototype, and a transaction.</p>
        <span class="reading-link__arrow" aria-hidden="true">→</span>
      </a>
      <a class="reading-link" href="/docs">
        <span class="reading-link__kind">Documentation</span>
        <h3>Get oriented without guessing.</h3>
        <p>Package-level setup, agents, contracts, architecture, security, and limitations.</p>
        <span class="reading-link__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="home-handoff section section--paper" aria-labelledby="home-handoff-title">
    <div class="wrap home-handoff__inner">
      <div class="home-handoff__mark" aria-hidden="true">
        <svg viewBox="0 0 128 96" role="presentation">
          <path d="M12 48H40V20H68V48H96V76H116" />
          <rect x="6" y="42" width="12" height="12" />
          <rect x="34" y="14" width="12" height="12" />
          <rect x="62" y="42" width="12" height="12" />
          <rect x="90" y="70" width="12" height="12" />
          <rect x="110" y="70" width="12" height="12" />
        </svg>
      </div>
      <div>
        <p class="eyebrow">A better handoff</p>
        <h2 id="home-handoff-title">Go from this overview to the source.</h2>
        <p>Open the repository for current code. Use the docs for setup notes. Keep any sensitive report out of public issues until a private channel is confirmed.</p>
      </div>
      <div class="button-row home-handoff__actions">
        <a class="button button--dark" href={REPOSITORY_URL} target="_blank" rel="noreferrer">Open GitHub <span aria-hidden="true">↗</span></a>
        <a class="button button--outline-dark" href="/docs/getting-started">Read the setup guide</a>
      </div>
    </div>
  </section>
</BaseLayout>
